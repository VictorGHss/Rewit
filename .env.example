# ==============================================================================
# REWIT - MATRIZ DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para ".env": "cp .env.example .env"
# 2. Preencha com valores apropriados para o seu ambiente local.
# 3. NUNCA faça commit do arquivo ".env" real com secrets no controle de versão.
# ==============================================================================

# ------------------------------------------------------------------------------
# PERFIL E IDENTIFICAÇÃO DO AMBIENTE
# ------------------------------------------------------------------------------
ENVIRONMENT=local
APP_NAME=rewit-platform

# ------------------------------------------------------------------------------
# BANCO DE DADOS PRINCIPAL (POSTGRESQL 18 + POSTGIS 3.6)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rewit_db
# Role de Migracao (Owner / Flyway / DDL):
POSTGRES_USER=rewit_user
POSTGRES_PASSWORD=change-me
# Role de Aplicacao Runtime (Restrita / DML apenas / Sem DDL / Sem Superuser):
# APP_DB_PASSWORD e obrigatoria e nao tem valor padrao: o init do PostgreSQL falha se estiver vazia.
# Rotacao em banco existente: docker compose exec postgres /docker-entrypoint-initdb.d/02-create-app-role.sh
APP_DB_USER=rewit_app
APP_DB_PASSWORD=
DATABASE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# CACHE E SESSÕES (REDIS 8)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ------------------------------------------------------------------------------
# ARMAZENAMENTO DE OBJETOS S3-COMPATIBLE (SEAWEEDFS 4.47 / AWS S3)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_PORT=8333
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_BUCKET=rewit-local
OBJECT_STORAGE_REGION=us-east-1

# Aliases de compatibilidade para clientes S3 genéricos
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=rewit-local

# ------------------------------------------------------------------------------
# BACKEND API (SPRING BOOT)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
LOGGING_LEVEL_COM_REWIT=DEBUG

# ------------------------------------------------------------------------------
# SEGURANÇA E AUTENTICAÇÃO (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=change-me
JWT_ISSUER=rewit-api
JWT_AUDIENCE=rewit-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Segredo do HMAC das chaves de rate limiting no Redis (mínimo 32 bytes, igual em todas as instâncias)
RATE_LIMIT_KEY_SECRET=change-me

# Segredo do HMAC do e-mail reservado de contas excluídas no purge (mínimo 32 bytes, estável, igual em todas as
# instâncias; trocá-lo invalida as reservas). Sem ele o purge não executa.
ACCOUNT_EMAIL_RESERVATION_SECRET=change-me

# ------------------------------------------------------------------------------
# CLOUDFLARE TUNNEL (OPCIONAL - DESENVOLVIMENTO LOCAL COM CELULAR FÍSICO)
# ------------------------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# LOGIN SOCIAL (OPCIONAL): client IDs públicos aceitos como audiência do ID token, separados por vírgula.
# Sem valor, o provedor fica desligado. A validação não usa segredo do provedor.
# ------------------------------------------------------------------------------
# Google: client ID "Web application" (serverClientId do app) e o client ID iOS
GOOGLE_SIGNIN_CLIENT_IDS=
# Apple: bundle ID do app iOS e Services ID do fluxo web (Android)
APPLE_SIGNIN_CLIENT_IDS=
# applicationId do app Android que recebe o retorno do fluxo web da Apple
APPLE_SIGNIN_ANDROID_PACKAGE=app.rewit.mobile

# ------------------------------------------------------------------------------
# INTEGRAÇÃO EXTERNA: GOOGLE APIS (OPCIONAL NO INÍCIO)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=exemplo_chave_maps_api
GOOGLE_PLACES_API_KEY=change-me

# Descoberta externa de locais: GOOGLE (padrão) ou GEOAPIFY (plano gratuito, dados OpenStreetMap).
# A chave fica só no backend; ver docs/integrations/geoapify.md.
PLACE_DISCOVERY_PROVIDER=GOOGLE
GEOAPIFY_API_KEY=


# ------------------------------------------------------------------------------
# PROVEDORES DE NOTIFICAÇÃO (ABSTRAÇÃO - MOCK EM AMBIENTE LOCAL)
# ------------------------------------------------------------------------------
NOTIFICATION_PROVIDER=mock
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------------------------
# APLICATIVO CLIENTE (ADMIN / WEB)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1
ADMIN_PORT=5173

# ------------------------------------------------------------------------------
# SERVIÇO DE VISÃO COMPUTACIONAL FUTURO (PYTHON)
# ------------------------------------------------------------------------------
VISION_SERVICE_HOST=localhost
VISION_SERVICE_PORT=8001
VISION_SERVICE_URL=http://${VISION_SERVICE_HOST}:${VISION_SERVICE_PORT}
